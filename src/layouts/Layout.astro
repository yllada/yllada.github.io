---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import BackgroundEffects from '../components/BackgroundEffects.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Yadian Llada Lopez — Senior Software Engineer · Backend & Cloud Architecture',
  description = 'Senior software engineer building Go backends for security platforms and AI products. UTMStack SIEM/XDR contributor, GitDocAI MVP engineer, maker of vpn-manager. Based in Cuba, open to remote.',
  image = '/images/perfil.jpg',
} = Astro.props;

const canonicalUrl = 'https://yllada.github.io/';
const ogImageUrl = new URL(image, canonicalUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yadian Llada Lopez',
  jobTitle: 'Senior Software Engineer',
  url: canonicalUrl,
  image: ogImageUrl,
  email: 'yadian.llada@gmail.com',
  sameAs: [
    'https://github.com/yllada',
    'https://www.linkedin.com/in/yllada94/',
  ],
  knowsAbout: [
    'Go',
    'gRPC',
    'OpenSearch',
    'PostgreSQL',
    'Docker',
    'GitHub Actions',
    'AWS',
    'Azure',
    'SIEM',
    'XDR',
    'Log parsing and correlation',
    'WireGuard',
    'OpenVPN',
    'Tailscale',
    'GTK4',
    'Wails',
    'Next.js',
    'React',
    'TypeScript',
    'OpenAI API',
    'Google Gemini',
  ],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CU',
  },
};
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Title & description -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Yadian" />
    <meta property="profile:last_name" content="Llada Lopez" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Person schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Font preloads (critical path) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/SourceSerif4-Regular.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/FiraCode-Regular.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/DepartureMono-Regular.woff2"
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  </head>

  <body>
    <!-- Skip to content (sr-only until focused) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-canvas focus:font-mono focus:text-sm focus:rounded-md"
    >
      Skip to content
    </a>

    <BackgroundEffects />
    <Nav />

    <main id="main" class="relative z-10">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Intersection Observer for data-reveal elements -->
    <!-- Gated by prefers-reduced-motion: no-preference -->
    <script>
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );

        document.querySelectorAll('[data-reveal]').forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
