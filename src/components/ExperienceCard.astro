---
import type { Experience } from '../data/experience';
import StackChip from './StackChip.astro';

export interface Props {
  entry: Experience;
}

const { entry } = Astro.props;
---

<article class="grid md:grid-cols-[160px_1fr] gap-6 md:gap-8 py-10">
  <!-- Left: company meta -->
  <div class="space-y-1">
    <p class="font-serif text-h3 font-semibold text-ink leading-[1.3]">
      {entry.companyUrl
        ? <a href={entry.companyUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors duration-120">{entry.company}</a>
        : entry.company
      }
    </p>
    <p class="font-label text-caption uppercase tracking-[0.08em] text-ink-faint">{entry.period}</p>
    <p class="font-mono text-code text-ink-faint">{entry.location}</p>
  </div>

  <!-- Right: role + highlights + stack -->
  <div class="space-y-4">
    <p class="font-serif italic text-body text-ink">{entry.role}</p>

    {entry.metric && (
      <p class="font-mono text-code text-ink-faint">{entry.metric}</p>
    )}

    <ul class="space-y-2">
      {entry.highlights.map((h) => (
        <li class="font-serif text-small text-ink-muted leading-[1.55] pl-4 relative before:absolute before:left-0 before:top-[0.6em] before:w-1.5 before:h-px before:bg-rule-strong">
          {h}
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap gap-2 pt-2">
      {entry.stack.map((tech) => (
        <StackChip label={tech} />
      ))}
    </div>
  </div>
</article>
